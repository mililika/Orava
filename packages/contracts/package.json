{
  "name": "@orava/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The API's request and response shapes as zod schemas, shared by the server and the web app.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@orava/core": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
