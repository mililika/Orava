  "pillars": [
    {
      "key": "fixed",
      "label": "Fixed costs",
      "maxPoints": 30,
      "fullAt": 0.3,
      "zeroAt": 0.6,
      "unit": "share",
      "measures": "Housing and utilities as a share of income (3 months).",
      "why": "The common rule is to keep housing within 30% of income; over 40% counts as overburdened in EU statistics. The typical S-Bank customer spends 37%, so the scale runs gently from 30% to 60%.",
      "sourceKey": "housing_overburden"
    },
    {
      "key": "kept",
      "label": "Left over",
      "maxPoints": 20,
      "fullAt": 0.2,
      "zeroAt": 0,
      "unit": "share",
      "measures": "Income minus spending over the last 3 months, as a share of income. Negative when you spend more than comes in. Money moved to investments counts as left over.",
      "why": "Keeping 20% is the classic savings target; Finnish households keep only about 2–5% on average.",
      "sourceKey": "savings_target"
    },
    {
      "key": "slips",
      "label": "Flexible spending",
      "maxPoints": 20,
      "fullAt": 0.2,
      "zeroAt": 0.3,
      "unit": "share",
      "measures": "Restaurants, entertainment, lifestyle and travel as a share of income (3 months). The less, the more points.",
      "why": "30% is the wants ceiling in the 50/30/20 rule; the typical S-Bank customer spends about 20%.",
      "sourceKey": "wants_ceiling"
    },
    {
      "key": "buffer",
      "label": "Savings buffer",
      "maxPoints": 20,
      "fullAt": 2,
      "zeroAt": 0,
      "unit": "months",
      "measures": "Average month-end balance divided by average monthly spending.",
      "why": "Finnish experts recommend a buffer of 2 months of expenses for surprises such as a broken washing machine or a gap in income.",
      "sourceKey": "buffer_months"
    },
    {
      "key": "overdraft",
      "label": "Never below zero",
      "maxPoints": 10,
      "fullAt": 0,
      "zeroAt": 2,
      "unit": "count",
      "measures": "Months in the last 3 where the balance dipped below €0, even for a day.",
      "why": "Running out of money before payday is the earliest sign of money stress, long before missed bills.",
      "sourceKey": null
    }
  ],
