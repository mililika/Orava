# Copy to mobile/.env and fill in (Supabase dashboard → Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional "Ask Orava" (part B). Address of `npm run ai-server`, NOT a key.
# Leave empty and the app hides Ask Orava. Phone on the same Wi-Fi: use the laptop's LAN IP.
# EXPO_PUBLIC_ORAVA_AI_URL=http://192.168.x.x:8787
