# Copy to server/.env.local (git-ignored) and fill in. Read only by `npm run ai-server`.
# Never put this key in an EXPO_PUBLIC_ variable: those are bundled into the app.
GEMINI_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=MINIMAL
# GEMINI_TIMEOUT_MS=8000
# ORAVA_AI_PORT=8787
# ORAVA_AI_HOST=0.0.0.0
