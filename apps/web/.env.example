# Copy to apps/web/.env and fill in. Every EXPO_PUBLIC_ value is bundled into the app, so only
# public values go here.

# Supabase dashboard → Project Settings → API: the Project URL and the publishable key. Used only
# for sign-in; the publishable key can't read our tables.
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional: where our API runs. Defaults to http://localhost:8080 in development and to the same
# origin (Vercel's /api rewrite) in production.
# EXPO_PUBLIC_API_URL=http://localhost:8080
