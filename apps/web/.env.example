# Copy to apps/web/.env if you need to change anything. The web app holds no secrets: it only
# talks to our own API, which has the database and AI credentials.

# Where the API is. Unset in development = http://localhost:8080 (npm run dev:server). Empty in
# production = same origin (Vercel rewrites /api/* to the server).
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Gemini (Google AI Studio → Get API key). Bundled into the app until section 06 moves AI to the
# server, so use a quota-capped demo key.
EXPO_PUBLIC_GEMINI_API_KEY=YOUR-GEMINI-API-KEY
# Optional: override the model (default gemini-3.8-flash) and how long it thinks
# (minimal | low | medium | high; default low). gemini-3.5-flash-lite is the quickest option.
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
# EXPO_PUBLIC_GEMINI_THINKING=low
