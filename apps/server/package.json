{
  "name": "@orava/server",
  "version": "0.0.0",
  "private": true,
  "description": "The Orava API (NestJS).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@orava/contracts": "*",
    "@orava/core": "*",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@swc/core-darwin-arm64": "1.16.22",
    "@swc/core-darwin-x64": "1.16.22",
    "@swc/core-linux-arm64-gnu": "1.16.22",
    "@swc/core-linux-x64-gnu": "1.16.22"
  }
}
