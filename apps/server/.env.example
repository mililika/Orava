NODE_ENV=development
# Supabase dashboard → Connect → Session pooler (port 5432, user postgres.<project-ref>).
# Put the real value only in apps/server/.env, never in this file.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
WEB_ORIGIN=http://localhost:8081
# Supabase dashboard → Project Settings → Data API → Project URL. Not a secret; the server checks
# sign-in tokens against this project's Auth signing keys.
SUPABASE_URL=https://PROJECT_REF.supabase.co
LOG_LEVEL=info

# Gemini: Google AI Studio → Get API key. Put the real key only in apps/server/.env. Without it
# the app works: Orava shows its built-in sentences and the chat input is grayed out.
GEMINI_API_KEY=
# Optional (defaults shown):
# GEMINI_MODEL=gemini-3.8-flash
# Used when the model above is rate-limited (429) or overloaded (503); empty = no fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING=low
# Gemini requests per user per rolling hour (users.ai_hourly_limit overrides it), and per UTC day
# across all users.
# AI_HOURLY_LIMIT=30
# AI_DAILY_LIMIT=2000
