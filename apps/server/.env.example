NODE_ENV=development
# Supabase dashboard → Connect → Session pooler (port 5432, user postgres.<project-ref>).
# Put the real value only in apps/server/.env, never in this file.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
WEB_ORIGIN=http://localhost:8081
LOG_LEVEL=info
